# canvas_task_monitor 环境变量样例
# 用法：复制本文件为 .env 并填入真实值；.env 已被 .gitignore 忽略，不会被提交。
# config/settings.yaml 中的 ${XXX} 占位符会在加载时被这里的同名环境变量替换。

# ===== Canvas LMS =====
# 形如 https://<你的学校>.instructure.com
CANVAS_BASE_URL=
# Canvas「账号 - 设置 - 新建访问令牌」生成的 API Token
CANVAS_TOKEN=

# ===== Microsoft Graph（仅当 mail.provider=graph 时使用）=====
# 注意：client_credentials 需要租户管理员授予应用级 Mail.Read 权限，
# 学生个人账号通常申请不到，优先使用下面的 IMAP。
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_USER_UPN=

# ===== IMAP（仅当 mail.provider=imap 时使用，推荐先用这条路径）=====
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=

# ===== LLM（OpenAI 兼容 /chat/completions 接口）=====
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
